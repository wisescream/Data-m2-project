# FinLake Environment Variables Example
# Copy this file to .env and adjust as necessary. Do not commit .env to source control!

# SQL Server
SQLSERVER_SA_PASSWORD=FinLake2026!StrongPass#
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=finlake_source

# MinIO (S3-compatible Object Storage)
MINIO_ROOT_USER=finlake_admin
MINIO_ROOT_PASSWORD=finlake_secret_key_2026!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=finlake

# Metastore Database (PostgreSQL)
METASTORE_DB_USER=hive
METASTORE_DB_PASSWORD=hive_password_2026!
METASTORE_DB_PORT=5433
METASTORE_DB_NAME=metastore

# Hive Metastore
HIVE_METASTORE_PORT=9083

# Trino Distributed SQL Engine
TRINO_PORT=8080

# AI Copilot Engine (Optional Groq API Key)
GROQ_API_KEY=your_groq_api_key_here
