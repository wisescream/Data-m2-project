FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    pyarrow==17.0.0 \
    pymssql==2.3.0 \
    minio==7.2.10

COPY . /app
ENV PYTHONPATH=/app

CMD ["python", "-m", "src.finlake.worker.runner"]
